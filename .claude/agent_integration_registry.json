  "activation_rules": {
    "priority_order": [
      "principal",
      "specialist", 
      "analysis"
    ],
    "conflict_resolution": {
      "same_level_conflicts": "collaborative_decision",
      "cross_level_conflicts": "defer_to_higher_authority",
      "deadlock_resolution": "escalate_to_arquitecto_principal"
    },
    "collaboration_protocols": {
      "cross_expert_coordination": "required_for_overlapping_domains",
      "analysis_integration": "analysis_agents_inform_execution_agents",
      "testing_integration": "testing_agents_validate_all_implementations"
    }
  },
  
  "workflow_integration": {
    "emergency_protocols": {
      "critical_bug_response": {
        "primary_agents": ["qa_tester", "arquitecto_principal"],
        "supporting_agents": "domain_specific_experts",
        "escalation_path": "arquitecto_principal -> deployment_specialist"
      },
      "security_incident": {
        "primary_agents": ["compliance_checker", "arquitecto_principal"],
        "supporting_agents": ["backend_specialist", "data_manager"],
        "escalation_path": "immediate_arquitecto_principal_involvement"
      }
    },
    "development_workflows": {
      "feature_development": {
        "planning": "arquitecto_principal + product_strategy_expert",
        "implementation": "domain_specific_agents",
        "validation": "qa_tester + analysis_agents",
        "deployment": "deployment_specialist"
      }
    }
  }
