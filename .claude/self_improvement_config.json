        "security_hardening",
        "scalability"
      ]
    },
    "ui_specialist": {
      "performance_metrics": [
        "accessibility_score",
        "design_consistency",
        "user_experience_rating",
        "animation_performance"
      ],
      "learning_domains": [
        "design_trends",
        "accessibility_standards",
        "animation_techniques",
        "user_behavior_patterns"
      ],
      "improvement_priorities": [
        "user_accessibility",
        "visual_consistency",
        "interaction_smoothness",
        "responsive_design"
      ]
    },
    "arquitecto_principal": {
      "performance_metrics": [
        "system_integration_score",
        "decision_quality",
        "coordination_efficiency",
        "strategic_alignment"
      ],
      "learning_domains": [
        "architecture_patterns",
        "technology_trends",
        "project_management",
        "team_coordination"
      ],
      "improvement_priorities": [
        "system_cohesion",
        "strategic_planning",
        "team_effectiveness",
        "technical_excellence"
      ]
