    "cloud_optimization": {
      "performance_settings": {
        "max_tokens_per_request": 8192,
        "temperature": 0.1,
        "top_p": 0.95,
        "presence_penalty": 0,
        "frequency_penalty": 0,
        "stream": true,
        "timeout_seconds": 300
