  "scoring_rules": {
    "low_risk": {
      "score_range": [0, 30],
      "response_level": "wellness_resources",
      "description": "General sadness or stress, no specific suicidal ideation"
    },
    "medium_risk": {
      "score_range": [31, 60],
      "response_level": "mental_health_resources",
      "description": "Hopelessness, passive ideation, no specific plan"
    },
    "high_risk": {
      "score_range": [61, 85],
      "response_level": "crisis_hotlines_prominent",
      "description": "Active suicidal ideation, possible plan forming"
    },
    "critical_risk": {
      "score_range": [86, 100],
      "response_level": "emergency_intervention",
      "description": "Imminent risk, method + plan + intent, immediate action"
    }
  },
  "detection_algorithm": {
    "steps": [
      "1. Identify language of message",
      "2. Tokenize and match against keyword database for that language",
      "3. Sum weights of all matched keywords",
      "4. Apply context modifiers (help-seeking, humor, etc.)",
      "5. Check for multiple high-severity keywords (requires 2+ for critical)",
      "6. Calculate final risk score",
      "7. Map to risk level",
      "8. Select appropriate response template"
    ],
    "minimum_keywords_for_high_risk": 2,
    "minimum_keywords_for_critical": 3,
    "require_method_for_critical": true
  }
